from pathlib import Path
import json,shutil,hashlib
root=Path(__file__).resolve().parents[1]
source=root/'artifacts/validation-final-2'
out=root/'docs/implementation-evidence'
out.mkdir(exist_ok=True)
report=json.loads((source/'report.json').read_text())
assert report['passed'] and report['sourceStable']
for name,digest in report['sourceHashes'].items():
    assert hashlib.sha256((root/name).read_bytes()).hexdigest()==digest,name
for name in ['report.json','contracts.json','roblox_types.txt','package.txt']:
    shutil.copyfile(source/name,out/name)
for path in source.glob('test_*.txt'):
    shutil.copyfile(path,out/path.name)
catalog=json.loads((root/'artifacts/catalog/catalog.json').read_text(encoding='utf-8'))
summary={'stages':len(catalog['stages']),'attackCycleRows':896,'legalItemCombinations':sum(v['count'] for v in catalog['bounds'].values()),'layoutSupportAssertions':194,'sourceHashes':catalog['sourceHashes'],'engineAcceptance':False}
(out/'catalog-summary.json').write_text(json.dumps(summary,indent=2),encoding='utf-8')
attempt={'status':'aborted-for-memory-pressure-before-usable-window','pidLaunchedAndClosed':9432,'place':'artifacts/validation-07/FloridaMan.rbxlx','before':{'freePhysicalKiB':1161100,'freeVirtualKiB':5605176},'during':{'freePhysicalKiB':192396,'freeVirtualKiB':2706700,'studioWorkingSetBytes':1024921600,'studioPrivateMemoryBytes':2271088640},'afterClose':{'freePhysicalKiB':1557920,'freeVirtualKiB':4870424},'pagefileConfigurationChanged':False,'unrelatedProcessesTerminated':False,'engineBootVerified':False,'runtimeHelpersExecuted':False}
(out/'engine-attempt.json').write_text(json.dumps(attempt,indent=2),encoding='utf-8')
print('Frozen evidence copied; current source hashes match the passing report.')
