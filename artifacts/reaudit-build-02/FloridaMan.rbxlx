		telegraphColor = Color3.fromRGB(120, 255, 180) },
}

Enemies.List = list
Enemies.ById = {} :: { [string]: EnemyDef }
for _, e in list do
	Enemies.ById[e.id] = e
end

function Enemies.Get(id: string): EnemyDef?
	return Enemies.ById[id]
end

function Enemies.Count(): number
	return #list
end

return Enemies
]]></string>
