		{ recovery = 0.20, rangeMul = 1.10, knockMul = 1.00, dmgMul = 1.10, cancelAfter = 0.1, label = "roman" },
		{ recovery = 0.30, rangeMul = 1.25, knockMul = 1.40, dmgMul = 1.42, cancelAfter = 0.15, label = "finale" },
	},
	LizardBreath = {
