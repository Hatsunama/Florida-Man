local Rules=require('../src/shared/TelemetryRules')
assert(Rules.FtueOutcome(0,59,true,false)=='success')
assert(Rules.FtueOutcome(0,60,false,false)=='timeout')
assert(Rules.FtueOutcome(0,12,false,true)=='abandon')
assert(Rules.FtueOutcome(0,12,false,false)==nil)
assert(Rules.FtueOutcome(nil,70,false,true)==nil)
local value,dimensions=Rules.Dimensions({value=0/0,stage='LabWing',reason='timeout',device='touch'})
assert(value==1 and dimensions[1]=='LabWing' and dimensions[2]=='timeout' and dimensions[3]=='touch')
print('telemetry: success, timeout, abandon and retained dimensions passed')
