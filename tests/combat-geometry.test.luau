local G = require("../src/shared/CombatGeometry")
local Character = require('../src/shared/CharacterGeometry')
assert(G.BossPhase(100, 100) == 1)
assert(G.BossPhase(66, 100) == 2)
assert(G.BossPhase(20, 100) == 3, "large hit skips directly to phase three")
assert(G.Damage(8, 100) == 8, "lifesteal uses actual damage, not overkill")
assert(G.Damage(0, 100) == 0)
assert(G.Damage(10, 0 / 0) == 0)
assert(G.Damage(10, math.huge) == 0)
assert(G.Damage(10, -4) == 0)
local near = G.SegmentBox(0, 3, 0, 20, 3, 0, 5, 3, 0, 1, 1, 1)
local far = G.SegmentBox(0, 3, 0, 20, 3, 0, 15, 3, 0, 1, 1, 1)
assert(near and far and near < far, "pierce order follows travel")
assert(math.abs(near - 0.2) < 0.000001, "swept collision catches between-frame target")
assert(G.SegmentBox(0, 10, 0, 20, 10, 0, 5, 3, 0, 1, 1, 1) == nil, "vertical separation matters")
assert(G.SegmentBox(0, 3, 5, 20, 3, 5, 5, 3, 0, 1, 1, 1) == nil, "lane separation matters")
assert(G.SegmentBox(5, 3, 0, 5, 3, 0, 5, 3, 0, 1, 1, 1) == 0, "stationary overlap")
assert(G.SegmentBox(20, 3, 0, 0, 3, 0, 5, 3, 0, 1, 1, 1) ~= nil, "both directions")
assert(G.NextCombo(1, 10.91, 10.90, 0.45) == 2, "slow recovery still permits combo continuation")
assert(G.NextCombo(2, 11.82, 11.81, 0.45) == 3, "slow third strike is reachable")
assert(G.NextCombo(2, 12.5, 11.81, 0.45) == 1, "idle grace expires after recovery")
assert(G.NextCombo(3, 12, 12, 0.45) == 1, "combo loops")
local muzzle = G.MuzzleY(3, 3)
assert(G.SegmentBox(0, muzzle, 0, 20, muzzle, 0, 5, 1.1, 0, 1, 0.33 + 0.3, 1) ~= nil, "flat ranged shots reach the lowest crab root")
assert(G.SegmentBox(0, G.MuzzleY(10, 3), 0, 20, G.MuzzleY(10, 3), 0, 5, 1.1, 0, 1, 0.63, 1) == nil, "jumping raises projectile collision with its rendered muzzle")
local coilY=G.GroundedCenterY(3,3,3)
assert(coilY==1.5)
for _,target in {{1.3,.44},{1,.5},{1.1,.6},{1.2,.35},{3.1,1.56}} do
	assert(G.SegmentBox(6,coilY,0,6,coilY,0,6,target[1],0,2,1.5+target[2],2)~=nil,'coil reaches grounded small and humanoid bodies')
end
assert(G.GroundedCenterY(10,3,3)==8.5,'jumping moves actual and rendered coil together')
for _,standing in {Character.StandingHeight(0,2,2),Character.StandingHeight(2,2,nil)} do
	assert(G.MuzzleY(3,standing)==1.2,'R6 and R15 use identical feet-relative projectile origin')
	assert(G.GroundedCenterY(3,standing,3)==1.5,'R6 and R15 use identical grounded coil center')
end
assert(G.HealFromDamage(80,100,G.Damage(8,100),.06)==80.48,'asynchronous lifesteal uses applied damage')
assert(G.HealFromDamage(99,100,100,.06)==100,'healing clamps at maximum')
assert(G.HealFromDamage(100,100,10,.06)==100,'full-health impact needs no healing snapshot')
print("PASS: combat geometry, grounded summon, damage-based healing, muzzle, and slow-combo assertions")
