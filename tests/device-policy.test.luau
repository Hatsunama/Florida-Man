local Device=require('../src/client/Controllers/DevicePolicy')
assert(Device.Cohort('None',true,false,false)=='touch','touch-only startup')
assert(Device.Cohort('Touch',true,true,false)=='touch','hybrid touching')
assert(Device.Cohort('Keyboard',true,true,false)=='keyboard','hybrid returned to keyboard')
assert(Device.Cohort('MouseMovement',true,true,false)=='keyboard','hybrid returned to mouse')
assert(Device.Cohort('Gamepad1',true,true,true)=='gamepad','controller selected')
assert(Device.Cohort('None',false,false,true)=='gamepad','controller-only startup')
assert(Device.Cohort('None',false,true,false)=='keyboard','desktop startup')
print('PASS 7 production input-device policies')
