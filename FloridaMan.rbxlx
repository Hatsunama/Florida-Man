          <string name="Source"><![CDATA[--!strict
--[[ Item catalog — 25+ power-ups. Inscriptions: HUMID FERAL LUCKY GREASY HEROIC CHAOS
	3 of a tag = set bonus. Florida Dew / Cold One is a stage pickup, not an item brand.
]]

local Items = {}

export type ItemDef = {
	id: string,
	name: string,
	description: string,
	rarity: string,
	inscription: string,
	statText: string,
	hpBonus: number,
	damageBonus: number,
	speedBonus: number,
	luckBonus: number,
	dodgeBonus: number,
	healOnPickup: number,
	special: string,
}

